{
    "name": "elephentity/elephentity",
    "description": "Compatibility package for the Elephentity runtime. Install elephentity/cli separately for development.",
    "type": "metapackage",
    "license": "Apache-2.0",
    "require": {
        "elephentity/runtime": "^0.10 || ^0.11"
    },
    "require-dev": {
        "php": ">=8.3",
        "opis/json-schema": "^2.3",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "elephentity/codegen": "^0.6",
        "elephentity/codegen-php": "^0.6",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Schema\\": "packages/schema/src/",
            "Eleph\\Runtime\\": "packages/runtime/src/",
            "Eleph\\Memory\\": "packages/memory/src/",
            "Eleph\\Cli\\": "packages/cli/src/",
            "Eleph\\Schema\\Tests\\": "packages/schema/tests/",
            "Eleph\\Runtime\\Tests\\": "packages/runtime/tests/",
            "Eleph\\Memory\\Tests\\": "packages/memory/tests/",
            "Eleph\\Cli\\Tests\\": "packages/cli/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "arch": "@php tools/check-architecture.php",
        "ci": [
            "@style",
            "@stan",
            "@arch",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
