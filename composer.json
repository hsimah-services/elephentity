{
    "name": "elephentity/elephentity",
    "description": "An AI-native framework for building PHP business logic from human-readable specs.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "opis/json-schema": "^2.3",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "elephentity/codegen": "dev-main#1db0082",
        "elephentity/codegen-php": "dev-main#e49152b",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "replace": {
        "elephentity/runtime": "self.version"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Schema\\": "packages/schema/src/",
            "Eleph\\Runtime\\": "packages/runtime/src/",
            "Eleph\\Memory\\": "packages/memory/src/",
            "Eleph\\Cli\\": "packages/cli/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Schema\\Tests\\": "packages/schema/tests/",
            "Eleph\\Runtime\\Tests\\": "packages/runtime/tests/",
            "Eleph\\Memory\\Tests\\": "packages/memory/tests/",
            "Eleph\\Cli\\Tests\\": "packages/cli/tests/"
        }
    },
    "bin": [
        "packages/cli/bin/eleph",
        "packages/memory/bin/eleph-gen-memory"
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "arch": "@php tools/check-architecture.php",
        "ci": [
            "@style",
            "@stan",
            "@arch",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
