parameters:
    level: max
    phpVersion: 80300
    paths:
        - packages
    excludePaths:
        analyse:
            - packages/*/vendor
            # Own dependencies and own CI (tests-graphql.yml, tests-sqlite.yml).
            - packages/graphql
            - packages/sqlite
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
