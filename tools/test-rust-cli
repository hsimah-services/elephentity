#!/usr/bin/env bash
#
# The Rust `eleph` and the PHP `eleph` on the same projects, side by side.
#
# Runs the four gates that exist so far (fmt, validate, generate, generate --check) with both
# compilers against the real eleph-codegen and a builder with no PHP in it, and requires:
#
#   - the same exit code from every command,
#   - byte-identical generated trees,
#   - the same problems reported for a broken spec (the lines naming file, pointer and code).
#
# The project is compiler/tests/fixtures/stub-project: its only target is a shell-script builder,
# so a project with no `php` target is proven to work end to end.
#
# Needs the built binaries, which CI builds for the PHP tests:
#
#   cargo build --release --locked --manifest-path vendor/elephentity/codegen/Cargo.toml
#   cargo build --release --locked --manifest-path compiler/Cargo.toml
#
# ELEPH_PHP is the PHP to run the PHP eleph with: `php` by default, `./tools/php php` locally.

set -euo pipefail

cd "$(dirname "$0")/.."

RUST_ELEPH="$PWD/compiler/target/release/eleph"
read -r -a PHP <<< "${ELEPH_PHP:-php}"
FIXTURE="compiler/tests/fixtures/stub-project"

for binary in "$RUST_ELEPH" "$PWD/vendor/elephentity/codegen/target/release/eleph-codegen"; do
    if [ ! -x "$binary" ]; then
        echo "tools/test-rust-cli: $binary is not built." >&2
        exit 1
    fi
done

# Inside the repository, so `vendor/bin/eleph-codegen` is found by walking up from the project,
# as it is for any project installed under a Composer root. build/ is git-ignored.
work="build/rust-cli"
rm -rf "$work"
mkdir -p "$work"
trap 'rm -rf "$work"' EXIT

failures=0

fail() {
    echo "FAIL $*" >&2
    failures=$((failures + 1))
}

# run <compiler> <project> <args...>: the exit code, with the output left in $project.out
run() {
    local compiler="$1" project="$2"
    shift 2
    local code=0

    if [ "$compiler" = rust ]; then
        "$RUST_ELEPH" --no-ansi "$@" --project "$project" > "$project.out" 2>&1 || code=$?
    else
        "${PHP[@]}" packages/cli/bin/eleph-php --no-ansi "$@" --project "$project" > "$project.out" 2>&1 || code=$?
    fi

    echo "$code"
}

# The lines that name a problem: indented, with a file, a pointer or a code. Everything else
# (the box PHP's console library draws, the wording of a summary) is presentation.
problems() {
    grep -E '^  .+\[[a-zA-Z]+\.[a-zA-Z]+\]$' "$1" | sort || true
}

compare() {
    local label="$1" php_code="$2" rust_code="$3"

    if [ "$php_code" != "$rust_code" ]; then
        fail "$label: PHP exited $php_code, Rust $rust_code"
        echo "--- PHP" >&2
        cat "$work/php.out" >&2
        echo "--- Rust" >&2
        cat "$work/rust.out" >&2
    else
        echo "ok   $label (exit $rust_code)"
    fi
}

for compiler in php rust; do
    cp -r "$FIXTURE" "$work/$compiler"
done

for gate in "fmt" "validate" "generate" "generate --check"; do
    # validate takes the spec directory as an argument; the other gates read it from eleph.json.
    php_extra=() rust_extra=()
    if [ "$gate" = validate ]; then
        php_extra=("$work/php/spec")
        rust_extra=("$work/rust/spec")
    fi

    # shellcheck disable=SC2086
    php_code="$(run php "$work/php" $gate "${php_extra[@]}")"
    # shellcheck disable=SC2086
    rust_code="$(run rust "$work/rust" $gate "${rust_extra[@]}")"

    compare "$gate" "$php_code" "$rust_code"
done

if diff -r "$work/php/generated" "$work/rust/generated" > /dev/null; then
    echo "ok   generated trees are byte-identical ($(find "$work/rust/generated" -type f | wc -l) files)"
else
    fail "the generated trees differ"
    diff -r "$work/php/generated" "$work/rust/generated" >&2 || true
fi

# Drift: edit a generated file by hand, and both must refuse it.
for compiler in php rust; do
    echo "tampered" >> "$work/$compiler/generated/project.txt"
done

compare "generate --check after a hand edit" \
    "$(run php "$work/php" generate --check)" \
    "$(run rust "$work/rust" generate --check)"

# A spec out of canonical order: both must refuse it and name the same file, path and order.
for compiler in php rust; do
    printf 'storage:\n  table: notes\nentity: Note\nfields:\n  title:\n    type: string\n' \
        > "$work/$compiler/spec/entities/Note.yml"
done

compare "fmt a mis-ordered spec" \
    "$(run php "$work/php" fmt)" \
    "$(run rust "$work/rust" fmt)"

php_problems="$(problems "$work/php.out" | sed "s#$work/php#PROJECT#g")"
rust_problems="$(problems "$work/rust.out" | sed "s#$work/rust#PROJECT#g")"

if [ "$php_problems" = "$rust_problems" ] && [ -n "$rust_problems" ]; then
    echo "ok   the same ordering problems are reported"
else
    fail "the ordering problems differ"
    printf 'PHP:\n%s\nRust:\n%s\n' "$php_problems" "$rust_problems" >&2
fi

# A broken spec: both must name the same problems, and the generator must never run.
for compiler in php rust; do
    printf 'entity: Note\nstorage:\n  table: notes\nfields:\n  id:\n    type: string\n  other:\n    type: Mystery\n' \
        > "$work/$compiler/spec/entities/Note.yml"
    rm -rf "$work/$compiler/generated"
done

compare "validate a broken spec" \
    "$(run php "$work/php" validate "$work/php/spec")" \
    "$(run rust "$work/rust" validate "$work/rust/spec")"

# Strip the project path so the two runs' problems are comparable.
php_problems="$(problems "$work/php.out" | sed "s#$work/php#PROJECT#g")"
rust_problems="$(problems "$work/rust.out" | sed "s#$work/rust#PROJECT#g")"

if [ "$php_problems" = "$rust_problems" ] && [ -n "$rust_problems" ]; then
    echo "ok   the same problems are reported"
else
    fail "the problems differ"
    printf 'PHP:\n%s\nRust:\n%s\n' "$php_problems" "$rust_problems" >&2
fi

compare "generate a broken spec" \
    "$(run php "$work/php" generate)" \
    "$(run rust "$work/rust" generate)"

if [ -e "$work/php/generated" ] || [ -e "$work/rust/generated" ]; then
    fail "a broken spec generated files"
fi

if [ "$failures" -ne 0 ]; then
    echo "$failures check(s) failed." >&2
    exit 1
fi

echo "The Rust eleph and the PHP eleph agree."
