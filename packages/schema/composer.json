{
    "name": "elephentity/schema",
    "description": "Spec parser, JSON Schema, pattern resolution and IR for Elephentity. Build-time only.",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "symfony/yaml": "^7.0 || ^8.0",
        "opis/json-schema": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Schema\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Schema\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit",
        "ci": [
            "@composer validate --strict",
            "@test"
        ]
    }
}
