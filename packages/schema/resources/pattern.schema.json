{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://dev.hbla.ke/elephentity/v0/pattern.schema.json",
    "title": "Elephentity pattern specification",
    "description": "A fragment of an entity spec. Any section an entity may declare, a pattern may declare.",
    "type": "object",
    "required": [
        "pattern"
    ],
    "additionalProperties": false,
    "properties": {
        "pattern": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/typeName"
        },
        "description": {
            "type": "string"
        },
        "use": {
            "type": "array",
            "items": {
                "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/typeName"
            },
            "uniqueItems": true
        },
        "requires": {
            "type": "object",
            "additionalProperties": false,
            "description": "Capabilities an entity must have for this pattern to apply. Using it elsewhere is a compile error naming the reason.",
            "properties": {
                "driver": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                }
            }
        },
        "config": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/configParameters"
        },
        "storage": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/storage"
        },
        "fields": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/fields"
        },
        "edges": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/edges"
        },
        "queries": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/queries"
        },
        "actions": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/actions"
        },
        "triggers": {
            "$ref": "https://dev.hbla.ke/elephentity/v0/common.schema.json#/$defs/triggers"
        }
    }
}
