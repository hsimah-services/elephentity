{
    "name": "elephentity/memory",
    "description": "An in-process StorageAdaptor with no backend of its own. The neutral driver for a project that wants raw PHP objects rather than WordPress.",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "elephentity/runtime": "^0.10 || ^0.11"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Memory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Memory\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit",
        "ci": [
            "@composer validate --strict",
            "@test"
        ]
    }
}
