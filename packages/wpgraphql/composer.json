{
    "name": "phefr/wpgraphql",
    "description": "Exposes PheFr entities and mutators to WPGraphQL from a compiled manifest.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "phefr/runtime": "self.version"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.7 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "PheFr\\WPGraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PheFr\\WPGraphQL\\Tests\\": "tests/"
        }
    }
}
