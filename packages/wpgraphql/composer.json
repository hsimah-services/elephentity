{
    "name": "elephentity/wpgraphql",
    "description": "Exposes Elephentity entities and mutators to WPGraphQL from a compiled manifest.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "elephentity/runtime": "self.version",
        "elephentity/schema": "self.version"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.7 || ^7.0",
        "axepress/wp-graphql-stubs": "^2.22"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\WPGraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\WPGraphQL\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/eleph-gen-wpgraphql"
    ]
}
