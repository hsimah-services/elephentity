#!/usr/bin/env php
<?php

declare(strict_types=1);

use PheFr\Cli\Command\CheckCommand;
use PheFr\Cli\Command\FmtCommand;
use PheFr\Cli\Command\GenerateCommand;
use PheFr\Cli\Command\ValidateCommand;
use Symfony\Component\Console\Application;

// Works both when PheFr is the root project and when it is installed as a dependency.
foreach ([__DIR__ . '/../../../vendor/autoload.php', __DIR__ . '/../../../../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;

        break;
    }
}

$application = new Application('phefr', '0.1.0');
$application->add(new ValidateCommand());
$application->add(new GenerateCommand());
$application->add(new CheckCommand());
$application->add(new FmtCommand());
$application->run();
