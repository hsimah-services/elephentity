#!/usr/bin/env php
<?php

declare(strict_types=1);

// Works both when PheFr is the root project and when it is installed as a dependency.
foreach ([__DIR__ . '/../../../vendor/autoload.php', __DIR__ . '/../../../../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;

        break;
    }
}

fwrite(STDERR, "phefr: no commands registered yet (Step 1).\n");

exit(1);
