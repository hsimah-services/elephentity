#!/bin/sh
# Launches the Rust `eleph`.
#
# Looked for, in order: a build in this package (target/release, then target/debug), a build in
# the repository's compiler/ when this is a checkout of it, and an `eleph` on PATH (what install.sh
# puts there). Composer links this file into vendor/bin, so its own location is resolved through
# the link first.
#
# When there is none, it runs the PHP implementation, `bin/eleph-php`, after saying so on stderr:
# `composer require` has always been enough to run `eleph`, and a Composer-only project must keep
# working. That is the same compiler at parity (it is the oracle the Rust one is measured against),
# so nothing about the result changes. The fallback goes when the PHP compiler is retired
# (docs/PLAN.md), at which point this prints the hint below and stops.
set -eu

self=$0
while [ -h "$self" ]; do
    target=$(readlink "$self")
    case "$target" in
        /*) self=$target ;;
        *) self=$(dirname "$self")/$target ;;
    esac
done
package_dir=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
self=$package_dir/bin/eleph

for binary in \
    "$package_dir/target/release/eleph" \
    "$package_dir/target/debug/eleph" \
    "$package_dir/../../compiler/target/release/eleph" \
    "$package_dir/../../compiler/target/debug/eleph"; do
    if [ -x "$binary" ]; then
        exec "$binary" "$@"
    fi
done

# An `eleph` on PATH, unless it is this very script. Composer's vendor/bin/eleph is a link to it or,
# by default, a proxy script that runs it, and `composer run` puts vendor/bin first on PATH, so a
# candidate can lead straight back here. Every candidate tried is recorded in ELEPH_LAUNCHER_TRIED,
# and one already tried is skipped, so the search moves on (to a real `eleph` further along, or to
# the fallback below) instead of running itself forever.
tried=":${ELEPH_LAUNCHER_TRIED:-}:"
old_ifs=$IFS
IFS=:
for directory in $PATH; do
    candidate=${directory:-.}/eleph
    if [ -x "$candidate" ] && [ -f "$candidate" ]; then
        resolved=$candidate
        while [ -h "$resolved" ]; do
            link=$(readlink "$resolved")
            case "$link" in
                /*) resolved=$link ;;
                *) resolved=$(dirname "$resolved")/$link ;;
            esac
        done
        resolved_dir=$(CDPATH= cd -- "$(dirname -- "$resolved")" && pwd)
        resolved=$resolved_dir/$(basename -- "$resolved")
        if [ "$resolved" = "$self" ]; then
            continue
        fi
        case "$tried" in
            *":$resolved:"*) continue ;;
        esac
        IFS=$old_ifs
        ELEPH_LAUNCHER_TRIED=${ELEPH_LAUNCHER_TRIED:+$ELEPH_LAUNCHER_TRIED:}$resolved
        export ELEPH_LAUNCHER_TRIED
        exec "$candidate" "$@"
    fi
done
IFS=$old_ifs

if [ -f "$package_dir/bin/eleph-php" ] && command -v php >/dev/null 2>&1; then
    printf '%s\n' "eleph: no Rust eleph found, so this is running the PHP compiler (bin/eleph-php), which is being retired. Install the Rust one with: curl -fsSL https://github.com/hsimah-services/elephentity/releases/latest/download/install.sh | sh" >&2
    exec php "$package_dir/bin/eleph-php" "$@"
fi

cat >&2 <<HINT
eleph: no Rust eleph found.

Install a prebuilt one, with no PHP or cargo needed:
  curl -fsSL https://github.com/hsimah-services/elephentity/releases/latest/download/install.sh | sh

Or, in a checkout of hsimah-services/elephentity:
  cargo build --release --manifest-path compiler/Cargo.toml

The PHP implementation is here as $package_dir/bin/eleph-php, and runs when PHP is installed.
HINT
exit 1
