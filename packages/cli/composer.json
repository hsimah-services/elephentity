{
    "name": "elephentity/cli",
    "description": "The eleph command: validate, generate, check, fmt. Build-time only.",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "symfony/console": "^7.0 || ^8.0",
        "elephentity/schema": "^0.11",
        "elephentity/runtime": "^0.10 || ^0.11",
        "elephentity/codegen": "^0.6"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/eleph",
        "bin/eleph-gen-memory"
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "elephentity/codegen-php": "^0.6"
    },
    "scripts": {
        "test": "phpunit",
        "ci": [
            "@composer validate --strict",
            "@test"
        ]
    }
}
