{
    "name": "elephentity/cli",
    "description": "The eleph command: validate, generate, check, fmt, migrate. Build-time only.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "symfony/console": "^7.0 || ^8.0",
        "elephentity/schema": "self.version",
        "elephentity/codegen": "self.version",
        "elephentity/wpgraphql": "self.version",
        "elephentity/wordpress": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/eleph"
    ]
}
