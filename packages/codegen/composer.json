{
    "name": "elephentity/codegen",
    "description": "Compiles the Elephentity IR into locked, signed PHP. Build-time only.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nette/php-generator": "^4.1",
        "elephentity/schema": "self.version",
        "elephentity/runtime": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Codegen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Codegen\\Tests\\": "tests/"
        }
    }
}
