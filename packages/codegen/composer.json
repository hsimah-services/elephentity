{
    "name": "elephentity/codegen",
    "description": "The target contract, signing and writing. Language-neutral; build-time only.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "elephentity/schema": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Codegen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Codegen\\Tests\\": "tests/"
        }
    }
}
