{
    "name": "phefr/codegen",
    "description": "Compiles the PheFr IR into locked, signed PHP. Build-time only.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nette/php-generator": "^4.1",
        "phefr/schema": "self.version"
    },
    "autoload": {
        "psr-4": {
            "PheFr\\Codegen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PheFr\\Codegen\\Tests\\": "tests/"
        }
    }
}
