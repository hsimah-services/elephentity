<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles every generated GraphQL manifest with the entities `eleph-gen-csharp` makes from the same IR, assembles the schema with
       Elephentity.GraphQL on the memory driver, runs it, and requires the SDL to equal the PHP stack's. A renamed manifest type or a
       read-model member the manifest misnames fails here, at compile time, which nothing else in this repository can do. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Where elephentity-dotnet is checked out: this repository's dotnet/ tree, copied there by CI (tools/dotnet mounts it locally). -->
    <ElephentityDotnet Condition="'$(ElephentityDotnet)' == ''">$(ELEPH_DOTNET_DIR)</ElephentityDotnet>
    <ElephentityDotnet Condition="'$(ElephentityDotnet)' == ''">$(MSBuildThisFileDirectory).deps/elephentity-dotnet</ElephentityDotnet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.GraphQL/Elephentity.GraphQL.csproj" />
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.Runtime.Memory/Elephentity.Runtime.Memory.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Using Include="Xunit" />
    <Content Include="../parity/*.graphql" Link="parity/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
