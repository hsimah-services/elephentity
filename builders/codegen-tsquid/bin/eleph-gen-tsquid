#!/bin/sh
set -eu
package_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for profile in release debug; do
    binary="$package_dir/target/$profile/eleph-gen-tsquid"
    if [ -x "$binary" ]; then
        exec "$binary" "$@"
    fi
done
printf '%s\n' "eleph-gen-tsquid: build with cargo build --release --locked --manifest-path $package_dir/Cargo.toml." >&2
exit 1
