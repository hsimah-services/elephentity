{
  "version": 1,
  "routes": [
    {
      "name": "Home",
      "path": "/",
      "ssr": true,
      "fields": {}
    },
    {
      "name": "Articles",
      "path": "/articles",
      "ssr": true,
      "fields": {
        "drafts": {
          "kind": "bool",
          "optional": true,
          "in": "query"
        },
        "page": {
          "kind": "int",
          "optional": true,
          "in": "query"
        },
        "tags": {
          "kind": "string[]",
          "optional": true,
          "in": "query"
        }
      },
      "query": {
        "operation": "ArticlesQuery",
        "id": "a1",
        "text": "query ArticlesQuery($page: Int = 1, $tags: [String!], $drafts: Boolean, $first: Int = 20, $order: Order = NEWEST, $after: String) { articles(page: $page, tags: $tags, drafts: $drafts, first: $first, order: $order, after: $after) { id } }",
        "variables": {
          "after": {},
          "drafts": {
            "input": "drafts"
          },
          "first": {
            "default": 20
          },
          "order": {
            "default": "NEWEST"
          },
          "page": {
            "input": "page",
            "default": 1
          },
          "tags": {
            "input": "tags"
          }
        }
      }
    },
    {
      "name": "Article",
      "path": "/articles/:id",
      "ssr": true,
      "fields": {
        "id": {
          "kind": "string",
          "optional": false,
          "in": "path"
        }
      },
      "query": {
        "operation": "ArticleQuery",
        "id": "a2",
        "text": "query ArticleQuery($id: ID!) { article(id: $id) { id } }",
        "variables": {
          "id": {
            "input": "id"
          }
        }
      }
    },
    {
      "name": "ArticleNew",
      "path": "/articles/new",
      "ssr": false,
      "fields": {}
    },
    {
      "name": "Section",
      "path": "/sections/:section/:page",
      "ssr": true,
      "fields": {
        "page": {
          "kind": "int",
          "optional": false,
          "in": "path"
        },
        "section": {
          "kind": "string",
          "optional": false,
          "in": "path"
        },
        "sort": {
          "kind": "string",
          "optional": true,
          "in": "query"
        }
      }
    },
    {
      "name": "Batch",
      "path": "/batch",
      "ssr": true,
      "fields": {
        "ids": {
          "kind": "int[]",
          "optional": false,
          "in": "query"
        }
      }
    },
    {
      "name": "Page",
      "path": "/:slug",
      "ssr": true,
      "fields": {
        "slug": {
          "kind": "string",
          "optional": false,
          "in": "path"
        }
      }
    }
  ]
}
