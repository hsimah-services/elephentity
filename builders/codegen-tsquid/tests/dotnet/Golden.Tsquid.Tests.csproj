<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loads the C# this builder emits into Elephentity.Tsquid and runs the SKILL's vectors.json against it. A renamed manifest type, or a
       field the emitter misnames, fails here at compile time, which nothing else in this repository can do. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Where elephentity-dotnet is checked out: this repository's dotnet/ tree, copied there by CI (tools/dotnet mounts it locally). -->
    <ElephentityDotnet Condition="'$(ElephentityDotnet)' == ''">$(ELEPH_DOTNET_DIR)</ElephentityDotnet>
    <ElephentityDotnet Condition="'$(ElephentityDotnet)' == ''">$(MSBuildThisFileDirectory).deps/elephentity-dotnet</ElephentityDotnet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.Tsquid/Elephentity.Tsquid.csproj" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Using Include="Xunit" />
    <Content Include="../fixtures/vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../fixtures/starter.manifest.json" Link="starter.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
