<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles every golden tree against the runtime it names as strings, and runs the first one on the memory driver.
       A renamed runtime type fails here, at compile time, which nothing else in this repository can do. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Where elephentity-dotnet is checked out: this repository's dotnet/ tree, copied there by CI (tools/dotnet mounts it locally). -->
    <ElephentityDotnet Condition="'$(ElephentityDotnet)' == ''">$(ELEPH_DOTNET_DIR)</ElephentityDotnet>
    <ElephentityDotnet Condition="'$(ElephentityDotnet)' == ''">$(MSBuildThisFileDirectory).deps/elephentity-dotnet</ElephentityDotnet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.Runtime/Elephentity.Runtime.csproj" />
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.Runtime.Memory/Elephentity.Runtime.Memory.csproj" />
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.Runtime.Testing/Elephentity.Runtime.Testing.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
