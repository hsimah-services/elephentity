#!/bin/sh
set -eu
package_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for profile in release debug; do
    binary="$package_dir/target/$profile/eleph-gen-php"
    if [ -x "$binary" ]; then
        exec "$binary" "$@"
    fi
done
printf '%s\n' "eleph-gen-php: build this checkout with cargo build --release --manifest-path $package_dir/Cargo.toml, or install with cargo install --path $package_dir --locked." >&2
exit 1
