{
    "name": "elephentity/codegen-php",
    "description": "The PHP builder for Elephentity: compiles the IR into locked PHP. Build-time only.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "nette/php-generator": "^4.1",
        "psr/container": "^2.0",
        "elephentity/runtime": "^0.17"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0",
        "elephentity/memory": "^0.17",
        "elephentity/sqlite": "^0.17",
        "elephentity/graphql": "^0.17"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\Gen\\Php\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\Gen\\Php\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/eleph-gen-php",
        "bin/eleph-check-php"
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "ci": [
            "@style",
            "@stan",
            "@test",
            "@test:runtime"
        ],
        "test:runtime": [
            "@php tests/generated-runtime.php",
            "@php tests/generated-runtime.php vendor/autoload.php sqlite"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
